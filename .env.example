# Browser (Vite) — safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: shows the demo-accounts box on the login page.
# Quote values containing "#" (e.g. "Shortlist#2026"); unquoted, the rest is read as a comment.
